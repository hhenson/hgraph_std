module hgraph.operators part operators_impl

# Parallel HGL implementations of the scalar operator domains listed below.
# Runtime bodies use scalar expressions and exposed native value functions.
# Existing core temporal operators remain installed under their own identities.

use hgraph.native as native

impl fn add_<L, R, O>(lhs: L, rhs: R) -> O
requires native::add(L, R) -> O {
    when {
        return native::add(lhs, rhs)
    }
}

impl fn sub_<L, R, O>(lhs: L, rhs: R) -> O
requires native::sub(L, R) -> O {
    when {
        return native::sub(lhs, rhs)
    }
}

impl fn mul_<L, R, O>(lhs: L, rhs: R) -> O
requires native::mul(L, R) -> O {
    when {
        return native::mul(lhs, rhs)
    }
}

impl fn div_<L, R, O>(lhs: L, rhs: R) -> O
requires native::div(L, R) -> O {
    when {
        return native::div(lhs, rhs)
    }
}

impl fn floordiv_<L, R, O>(lhs: L, rhs: R) -> O
requires native::floordiv(L, R) -> O {
    when {
        return native::floordiv(lhs, rhs)
    }
}

impl fn mod_<L, R, O>(lhs: L, rhs: R) -> O
requires native::mod(L, R) -> O {
    when {
        return native::mod(lhs, rhs)
    }
}

impl fn eq_<L, R>(lhs: L, rhs: R) -> bool
requires native::eq(L, R) -> bool {
    when {
        return native::eq(lhs, rhs)
    }
}

impl fn ne_<L, R>(lhs: L, rhs: R) -> bool
requires native::ne(L, R) -> bool {
    when {
        return native::ne(lhs, rhs)
    }
}

impl fn lt_<L, R>(lhs: L, rhs: R) -> bool
requires native::lt(L, R) -> bool {
    when {
        return native::lt(lhs, rhs)
    }
}

impl fn le_<L, R>(lhs: L, rhs: R) -> bool
requires native::le(L, R) -> bool {
    when {
        return native::le(lhs, rhs)
    }
}

impl fn gt_<L, R>(lhs: L, rhs: R) -> bool
requires native::gt(L, R) -> bool {
    when {
        return native::gt(lhs, rhs)
    }
}

impl fn ge_<L, R>(lhs: L, rhs: R) -> bool
requires native::ge(L, R) -> bool {
    when {
        return native::ge(lhs, rhs)
    }
}

impl fn neg_<T, O>(ts: T) -> O
requires native::neg(T) -> O {
    when {
        return native::neg(ts)
    }
}

