module hgraph.std part temporal_impl

# Parallel calendar and endpoint-metadata operators.

impl fn year(ts: date) -> i64 {
    inject out
    when {
        let component = native::year(ts)
        if !valid(out) || out != component {
            out = component
        }
    }
}

impl fn month(ts: date) -> i64 {
    inject out
    when {
        let component = native::month(ts)
        if !valid(out) || out != component {
            out = component
        }
    }
}

impl fn day(ts: date) -> i64 {
    inject out
    when {
        let component = native::day(ts)
        if !valid(out) || out != component {
            out = component
        }
    }
}

impl fn weekday(ts: date) -> i64 {
    when {
        return native::weekday(ts)
    }
}

impl fn isoweekday(ts: date) -> i64 {
    when {
        return native::isoweekday(ts)
    }
}

