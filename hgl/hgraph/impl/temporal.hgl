impl fn month_of_year(ts: date) -> i64 {
    inject out
    when {
        let component = native::month(ts)
        if !valid(out) || out != component {
            out = component
        }
    }
}

impl fn month_of_year(ts: datetime) -> i64 {
    when {
        return native::month(ts)
    }
}

impl fn day_of_month(ts: date) -> i64 {
    inject out
    when {
        let component = native::day(ts)
        if !valid(out) || out != component {
            out = component
        }
    }
}

impl fn day_of_month(ts: datetime) -> i64 {
    when {
