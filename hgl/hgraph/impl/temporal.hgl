    }
}

impl fn last_modified_time(ts: signal) -> datetime {
    when modified(ts) {
        return last_modified(ts)
    }
}

impl fn last_modified_date(ts: signal) -> date {
    when modified(ts) {
        return native::calendar_date(last_modified(ts))
    }
}
