/**
Write the string as it ticks, through the native ``print_line``.
*/
impl fn print_(format_str: str) {
    when { native::print_line(format_str) }
}

/**
Send ``[last modified] text`` to the run's logger at INFO.

Notes:
    hgraph's ``logger.log(level, "[%s] %s", ts.last_modified_time, ts.value)``.
    The tick counter is node-local and not recorded (cache), as hgraph's is.
*/
impl fn log_(format_str: str, const sample_count: i64 = 1) {
    inject logger
    cache ticks: i64 = 0
    when {
        ticks += 1
        if sample_count > 1 {
            if ticks % sample_count == 0 {
                info(logger, "[" + native::as_str(last_modified(format_str)) + "] " + format_str)
            }
        } else {
            info(logger, "[" + native::as_str(last_modified(format_str)) + "] " + format_str)
        }
    }
}

/**
Raise through the native ``raise_error`` on a false tick.
*/
impl fn assert_(condition: bool, const error_msg: str) {
    when {
        if !condition {
            native::raise_error(error_msg)
        }
    }
}
