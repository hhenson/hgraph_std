module hgraph.std part control_impl

# Variadic control contracts remain pending: all_/any_ need startup output;
# merge/race need full reference/reselection and structural parity.
# Implemented scalar control/sink slices appear below.

impl fn if_true(condition: bool, const tick_once_only: bool = false) -> bool {
    state ticked: bool = false
    when {
        if condition && (!tick_once_only || !ticked) {
            ticked = true
            return true
        }
    }
}

impl fn null_sink(ts: signal) { when { } }

impl fn pass_through<T>(ts: T) -> T { when { return ts } }
instantiate pass_through<bool>, pass_through<i64>, pass_through<f64>, pass_through<str>,
    pass_through<date>, pass_through<time>, pass_through<datetime>, pass_through<duration>
