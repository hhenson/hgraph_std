module hgraph.std part control_impl

use hgraph.native as native

# Variadic control contracts remain pending: all_/any_ need startup output;
# merge/race need full reference/reselection and structural parity.
# Implemented scalar control/sink slices appear below.

impl fn if_true(condition: bool, const tick_once_only: bool = false) -> bool {
    state ticked: bool = false
    when {
        if condition && (!tick_once_only || !ticked) {
            ticked = true
            return true
        }
    }
}

impl fn null_sink(ts: signal) { when { } }

impl fn pass_through<T>(ts: T) -> T { when { return ts } }
instantiate pass_through<bool>, pass_through<i64>, pass_through<f64>, pass_through<str>,
    pass_through<date>, pass_through<time>, pass_through<datetime>, pass_through<duration>

# Sources. A runtime function with no temporal parameters injects the
# scheduler; `start` asks for the first evaluation and `when scheduled()`
# publishes on that alarm (ADR 0010). const_ ticks once at the run's start
# plus delay, hgraph's `yield start_time + delay, value`.
impl fn const_<T>(const value: T, const delay: duration = 0s) -> T {
    inject scheduler
    start { scheduler.schedule(delay) }
    when scheduled() { return value }
}
instantiate const_<bool>, const_<i64>, const_<f64>, const_<str>,
    const_<date>, const_<time>, const_<datetime>, const_<duration>

# Never ticks: nothing is ever scheduled, so the handler never runs. The
# result type is taken from the call site, as hgraph's nothing[TS[T]]().
impl fn nothing<T>() -> T {
    inject scheduler
    when scheduled() { }
}
instantiate nothing<bool>, nothing<i64>, nothing<f64>, nothing<str>,
    nothing<date>, nothing<time>, nothing<datetime>, nothing<duration>

# Forward ts while it is valid, otherwise expose default_value. hgraph binds
# the output to whichever input is current through a reference; this scalar
# slice forwards the values, which observes the same ticks. Each handler
# names its own validity, so neither waits for the other input to be valid.
# ts is checked first: when both tick in one cycle the primary wins.
# TODO: when ts is invalidated hgraph exposes default_value at once; a
# runtime function cannot observe an invalidation tick yet, so here the
# fallback reappears on default_value's next tick.
impl fn default<T>(ts: T, default_value: T) -> T {
    when modified(ts) && valid(ts) {
        return ts
    }
    when modified(default_value) && valid(default_value) && !valid(ts) {
        return default_value
    }
}
instantiate default<bool>, default<i64>, default<f64>, default<str>,
    default<date>, default<time>, default<datetime>, default<duration>

# Diagnostic sinks. The text is Python's str() of the value, supplied by the
# native as_str projection so the rendering matches hgraph's str_/format_.
# print_delta is accepted for API parity: an atomic value's delta is the
# value itself, so the scalar slice prints the same text either way.
# sample > 1 prints every sample-th tick with a `[sample]` prefix; the tick
# counter is node-local diagnostic data and is not recorded (cache, ADR 0011).
# One body per scalar type: a generic body cannot select among the native
# as_str overloads for a type parameter.
impl fn debug_print(const label: str, ts: bool, const print_delta: bool = true, const sample: i64 = -1) {
    cache ticks: i64 = 0
    when {
        ticks += 1
        if sample > 1 {
            if ticks % sample == 0 {
                native::print_line("[" + native::as_str(sample) + "] " + label + ": " + native::as_str(ts))
            }
        } else {
            native::print_line(label + ": " + native::as_str(ts))
        }
    }
}

