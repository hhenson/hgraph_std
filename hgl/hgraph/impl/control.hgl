# print_ writes the string as it ticks; hgraph's print_(format_str) without
# arguments prints the string verbatim. The formatted forms remain pending
# on format_ (see the contract).
impl fn print_(format_str: str) {
    when { native::print_line(format_str) }
}

# log_ sends "[last modified] text" to the run's logger at INFO, hgraph's
# `logger.log(level, "[%s] %s", ts.last_modified_time, ts.value)`.
# sample_count > 1 logs every sample_count-th tick; the tick counter is
# node-local and not recorded (cache), as hgraph's is. The level and the
# formatted forms remain pending (see the contract).
impl fn log_(format_str: str, const sample_count: i64 = 1) {
    inject logger
    cache ticks: i64 = 0
    when {
        ticks += 1
        if sample_count > 1 {
            if ticks % sample_count == 0 {
                logger.info("[" + native::as_str(last_modified(format_str)) + "] " + format_str)
            }
        } else {
            logger.info("[" + native::as_str(last_modified(format_str)) + "] " + format_str)
        }
    }
}

# Every tick of a false condition raises with the message; the raise ends the
# evaluation under hgraph's node error model (ADR 0009).
impl fn assert_(condition: bool, const error_msg: str) {
    when {
        if !condition {
            native::raise_error(error_msg)
        }
    }
}
