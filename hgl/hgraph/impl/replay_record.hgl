module hgraph.std part replay_record_impl

impl fn replay<T>(const values: list<TimedValue<delta_of(T)>>) -> T
{
    var index: i64 = 0
    while index < len(values) {
        yield values[index].time: values[index].value
        index += 1
    }
}

impl fn record<T>(ts: T, const key: str)
{
    inject global_state, clock
    start {
        let initial: list<TimedValue<delta_of(T)>> = []
        set(global_state, key, initial)
    }
    when {
        var recording: list<TimedValue<delta_of(T)>> = get(global_state, key)
        push(recording, TimedValue<delta_of(T)>(
            time: clock.evaluation_time,
            value: delta_value(ts)
        ))
    }
}

instantiate replay<_>, record<_>
