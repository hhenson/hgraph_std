module hgraph.std part replay_record_impl

impl fn replay<T>() -> T
requires T in {bool, i64, f64, str, date, time, datetime, duration}
{
    inject replay_input, alarm, clock
    cache index: i64 = 0

    start {
        if len(replay_input) > 0 {
            schedule(alarm, 0s)
        }
    }

    when {
        let current = index
        index += 1
        if index < len(replay_input) {
            schedule_at(alarm, clock.next_cycle_evaluation_time)
        }
        let item = replay_input[current]
        if item != null {
            return item
        }
    }
}

impl fn record<T>(ts: T)
requires T in {bool, i64, f64, str, date, time, datetime, duration}
{
    inject capture

    start {
        begin(capture)
    }

    when {
        append(capture, last_modified(ts), delta_value(ts))
    }
}

instantiate replay<bool>, replay<i64>, replay<f64>, replay<str>,
    replay<date>, replay<time>, replay<datetime>, replay<duration>,
    record<bool>, record<i64>, record<f64>, record<str>,
    record<date>, record<time>, record<datetime>, record<duration>
