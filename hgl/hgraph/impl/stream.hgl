module hgraph.std part stream_impl

# Parallel scalar stream domains. Structural delta forwarding is tracked
# separately in the migration catalogue.

# Input activity and the node scheduler (ADR 0010). These bodies mirror the
# native nodes tick for tick; a restored exhausted `take` passivates on its
# first evaluation rather than in `start`, because a start block cannot
# reach the temporal inputs.
impl fn take<T>(ts: T, const count: i64 = 1) -> T {
    state seen: i64 = 0
    when {
        let index = seen + 1
        if count <= 0 || index > count {
            passivate(ts)
        } else {
            seen = index
            if index >= count {
                passivate(ts)
            }
            return ts
        }
    }
}

impl fn freeze<T>(predicate: bool, ts: T) -> T {
    when valid(predicate) {
        if predicate {
            passivate(predicate)
            passivate(ts)
            if valid(ts) {
                return ts
            }
        } else if modified(ts) && valid(ts) {
            return ts
        }
    }
}

impl fn until_true(ts: bool) -> bool {
    when {
        if ts {
            passivate(ts)
        }
        return ts
    }
}

# Pending alarms and the historical emission count are recovered separately.
# Start validates the delay and never replenishes an exhausted tick budget.
impl fn schedule(const delay: duration, const initial_delay: bool = true,
                 const max_ticks: i64 = 9223372036854775807, const use_wall_clock: bool = false) -> bool {
    state ticks: i64 = 0
    inject scheduler
    start {
        native::require_positive_delay(delay)
        if ticks < max_ticks {
            if initial_delay {
                scheduler.schedule(delay, use_wall_clock)
            } else {
                scheduler.schedule(0s, use_wall_clock)
            }
        }
    }
    when scheduled() {
        if ticks < max_ticks {
            ticks += 1
            if ticks < max_ticks {
                scheduler.schedule(delay, use_wall_clock)
            }
            return true
        }
    }
}

impl fn sample<T>(signal: signal, ts: T) -> T {
    when modified(signal) && valid(signal, ts) {
        return ts
    }
}

impl fn drop<T>(ts: T, const count: i64 = 1) -> T {
    state seen: i64 = 0
    when {
        let emit_value = seen >= count
        seen += 1
        if emit_value {
            return ts
        }
    }
}

impl fn filter_<T>(condition: bool, ts: T) -> T {
    state was_open: bool = false
    inject out
    when modified(condition, ts) && valid(condition) {
        let open = valid(condition) && condition
        if open && valid(ts) {
            if !was_open {
                if !valid(out) || last_modified(out) < last_modified(ts) {
                    out = ts
                }
            } else if modified(ts) {
                out = ts
            }
        }
        was_open = open
    }
}

instantiate sample<bool>, sample<i64>, sample<f64>, sample<str>,
    sample<date>, sample<time>, sample<datetime>, sample<duration>,
    drop<bool>, drop<i64>, drop<f64>, drop<str>,
    drop<date>, drop<time>, drop<datetime>, drop<duration>,
    filter_<bool>, filter_<i64>, filter_<f64>, filter_<str>,
    filter_<date>, filter_<time>, filter_<datetime>, filter_<duration>,
    take<bool>, take<i64>, take<f64>, take<str>,
    take<date>, take<time>, take<datetime>, take<duration>,
    freeze<bool>, freeze<i64>, freeze<f64>, freeze<str>,
    freeze<date>, freeze<time>, freeze<datetime>, freeze<duration>

impl fn dedup(ts: bool) -> bool {
    state have_last: bool = false
    state last: bool = false
    when {
        let changed = !have_last || last != ts
        last = ts
        have_last = true
        if changed {
            return ts
        }
    }
}

impl fn dedup(ts: i64) -> i64 {
    state have_last: bool = false
    state last: i64 = 0
    when {
        let changed = !have_last || last != ts
        last = ts
        have_last = true
        if changed {
            return ts
        }
    }
}

impl fn dedup(ts: str) -> str {
    state have_last: bool = false
    state last: str = ""
    when {
        let changed = !have_last || last != ts
        last = ts
        have_last = true
        if changed {
            return ts
        }
    }
}

