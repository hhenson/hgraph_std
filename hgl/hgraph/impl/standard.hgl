        }
    }
}

impl fn is_empty<K, V>(value: map<K, V>) -> bool {
    inject out

    when {
        let current = native::is_empty(value)
        if !valid(out) || out != current {
            out = current
        }
    }
}

instantiate is_empty<_, _>, is_empty<_>

impl fn index_of<const size: i64>(ts: list<i64, size>, item: i64) -> i64 {
    inject out
    when {
        var found = -1
        for index, value in items(ts) {
            if found == -1 && valid(value) && value == item { found = index }
        }
        if !valid(out) || out != found { return found }
    }
}

