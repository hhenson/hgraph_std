# Named target projections avoid an implicit target-type policy in a runtime body.
impl fn to_int(ts: bool) -> i64 { when { return native::as_int(ts) } }
impl fn to_int(ts: f64) -> i64 { when { return native::as_int(ts) } }
impl fn to_float(ts: bool) -> f64 { when { return native::as_float(ts) } }
impl fn to_float(ts: i64) -> f64 { when { return native::as_float(ts) } }
impl fn to_bool(ts: i64) -> bool { when { return native::truthy(ts) } }
impl fn to_bool(ts: f64) -> bool { when { return native::truthy(ts) } }
impl fn to_date(ts: datetime) -> date { when { return native::calendar_date(ts) } }
impl fn to_datetime(ts: date) -> datetime { when { return native::midnight(ts) } }

impl fn contains_(ts: set<bool>, item: bool) -> bool {
    inject out
    when modified(ts, item) && valid(item) {
        if native::bound(ts) {
            let present = valid(ts) && contains(ts, item)
            if modified(item) || !valid(out) || out != present { return present }
        }
    }
}

