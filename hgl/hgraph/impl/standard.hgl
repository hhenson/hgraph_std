# Scalar-valued map accumulation. TSS accumulation remains blocked: native
# duplicate adds publish an empty delta, but HGL upsert suppresses that event.
# Map reset/exclusion needs prior-output traversal and optional-input signatures.
impl fn collect_map<K>(key: K, ts: bool) -> map<K, bool> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: i64) -> map<K, i64> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: f64) -> map<K, f64> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: str) -> map<K, str> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: date) -> map<K, date> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: time) -> map<K, time> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: datetime) -> map<K, datetime> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: duration) -> map<K, duration> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn make_tsd<K>(key: K, value: bool) -> map<K, bool> {
    inject out
    when { upsert(out, key, value) }
}
impl fn make_tsd<K>(key: K, value: i64) -> map<K, i64> {
    inject out
    when { upsert(out, key, value) }
}
impl fn make_tsd<K>(key: K, value: f64) -> map<K, f64> {
    inject out
    when { upsert(out, key, value) }
}
impl fn make_tsd<K>(key: K, value: str) -> map<K, str> {
    inject out
    when { upsert(out, key, value) }
}
impl fn make_tsd<K>(key: K, value: date) -> map<K, date> {
    inject out
    when { upsert(out, key, value) }
}
impl fn make_tsd<K>(key: K, value: time) -> map<K, time> {
    inject out
    when { upsert(out, key, value) }
}
impl fn make_tsd<K>(key: K, value: datetime) -> map<K, datetime> {
    inject out
    when { upsert(out, key, value) }
}
impl fn make_tsd<K>(key: K, value: duration) -> map<K, duration> {
    inject out
    when { upsert(out, key, value) }
}
impl fn make_tsd_remove<K>(key: K, value: bool, remove_key: bool) -> map<K, bool> {
    inject out
    when valid(key) && modified(key, value, remove_key) {
        let remove = valid(remove_key) && remove_key && modified(key, remove_key)
        if remove {
            discard(out, key)
        } else if valid(value) && modified(key, value) {
            upsert(out, key, value)
        }
    }
}
impl fn make_tsd_remove<K>(key: K, value: i64, remove_key: bool) -> map<K, i64> {
    inject out
    when valid(key) && modified(key, value, remove_key) {
        let remove = valid(remove_key) && remove_key && modified(key, remove_key)
        if remove {
            discard(out, key)
        } else if valid(value) && modified(key, value) {
            upsert(out, key, value)
        }
    }
}
impl fn make_tsd_remove<K>(key: K, value: f64, remove_key: bool) -> map<K, f64> {
    inject out
    when valid(key) && modified(key, value, remove_key) {
        let remove = valid(remove_key) && remove_key && modified(key, remove_key)
        if remove {
            discard(out, key)
        } else if valid(value) && modified(key, value) {
            upsert(out, key, value)
