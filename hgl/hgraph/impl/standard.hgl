instantiate index_of<_>

impl fn contains_(ts: set<i64>, item: set<i64>) -> bool {
    inject out
    when {
        var contained = true
        for value in elements(item) {
            if !contains(ts, value) { contained = false }
        }
        if !valid(out) || out != contained { return contained }
    }
}

