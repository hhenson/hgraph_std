module hgraph.std part reference_capture_tests

test {
    const fn capture_ref_checked(index: i64) -> result<i64, error> {
        if index < 0 { return err(error(message: "route rejected")) }
        return ok(index)
    }
    fn capture_ref_choose(index: i64, first: ref<i64>, second: ref<i64>) -> ref<i64> {
        when {
            let selected = capture_ref_checked(index)?
            if selected == 0 { return first }
            return second
        }
    }
    fn capture_ref_read(value: i64) -> i64 { when { return delta_value(value) } }
    fn capture_ref_followed(index: i64, first: i64, second: i64) -> i64 {
        let seen = capture(capture_ref_choose, index, first, second)
        capture_ref_read(seen.value)
    }
    fn capture_ref_observe(reference: ref<i64>, data: i64, failure: error, step: i64) -> atomic<tuple<bool, bool, bool, bool, i64, bool, bool>> {
        # Observe unpublished data and errors without requiring them to be valid.
        when modified(step) && valid(step) {
            var value = -1
            if valid(data) { value = data }
            return (valid(reference), modified(reference), valid(data), modified(data), value, valid(failure), modified(failure))
        }
    }
    fn capture_ref_state(index: i64, first: i64, second: i64, step: i64) -> atomic<tuple<bool, bool, bool, bool, i64, bool, bool>> {
        let seen = capture(capture_ref_choose, index, first, second)
        capture_ref_observe(seen.value, seen.value, seen.error, step)
    }

    test capture_reference_preserves_designation_and_target_histories {
        assert eval(capture_ref_state,
            index: [_, 0, 1, 1, _, 0],
            first: [7, _, _, _, _, 9], second: [_, _, _, _, 20],
            step: [1, 1, 1, 1, 1, 1]
        ) == [
            (false, false, false, false, -1, false, false),
            (true, true, true, true, 7, false, false),
            (true, true, false, false, -1, false, false),
            (true, false, false, false, -1, false, false),
            (true, false, true, true, 20, false, false),
            (true, true, true, true, 9, false, false)
        ]
        # Different endpoints holding equal values still sample on re-pointing.
        assert eval(capture_ref_followed,
            index: [0, 1, 1], first: [7], second: [7]
        ) == [7, 7, _]
    }

    test capture_reference_failure_keeps_the_previous_live_target {
        assert eval(capture_ref_state,
            index: [0, -1, 1, -1, 0, _],
            first: [7, 8, 9, 10, 11, 12], second: [20, 21, 22, 23, 24, 25],
            step: [1, 1, 1, 1, 1, 1]
        ) == [
            (true, true, true, true, 7, false, false),
            (true, false, true, true, 8, true, true),
            (true, true, true, true, 22, true, false),
            (true, false, true, true, 23, true, true),
            (true, true, true, true, 11, true, false),
            (true, false, true, true, 12, true, false)
        ]
    }

    fn capture_ref_writes_first(index: i64, first: ref<i64>, second: ref<i64>) -> ref<i64> {
        inject out
        when {
            if index < 0 {
                out = first
                capture_ref_checked(index)?
            }
            if index == 0 { return first }
            return second
        }
    }
    fn capture_ref_preserved_write(index: i64, first: i64, second: i64, step: i64) -> atomic<tuple<bool, bool, bool, bool, i64, bool, bool>> {
        let seen = capture(capture_ref_writes_first, index, first, second)
        capture_ref_observe(seen.value, seen.value, seen.error, step)
    }
    test capture_reference_keeps_a_designation_written_before_failure {
        assert eval(capture_ref_preserved_write,
            index: [0, 1, -1, 1], first: [7, 8, 9, 10], second: [20, 21, 22, 23],
            step: [1, 1, 1, 1]
        ) == [
            (true, true, true, true, 7, false, false),
            (true, true, true, true, 21, false, false),
            (true, true, true, true, 9, true, true),
            (true, true, true, true, 23, true, false)
        ]
    }
}
