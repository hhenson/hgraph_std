module hgraph.std part nullable_dictionary_lookup_tests

test {

    const fn lookup_test_price_or_zero(book: map<str, i64>, key: str) -> i64 {
        let price = get(book, key)
        if price == null { return 0 }
        return price
    }
    const fn lookup_test_fallback(book: map<str, i64>, key: str) -> i64 =>
        get(book, key, default: 5)
    const fn lookup_test_strict(book: map<str, i64>, key: str) -> i64 => book[key]
    const fn lookup_test_strict_at(book: map<str, i64>, key: str) -> i64 => at(book, key)
    const fn lookup_test_eager_default(book: map<str, i64>, key: str) -> i64 =>
        get(book, key, default: at(map<str, i64>(items: []), "fallback"))
    fn lookup_test_atomic_price(book: atomic<map<str, i64>>, key: str) -> i64 {
        when {
            let price = get(book, key, default: null)
            if price != null { return price }
        }
    }
    fn lookup_test_atomic_strict(book: atomic<map<str, i64>>, key: str) -> i64 {
        when { return book[key] }
    }

    test nullable_dictionary_lookup {
        let zero = map<str, i64>(items: ["X": 0])
        let empty = map<str, i64>(items: [])
        assert lookup_test_price_or_zero(zero, "X") == 0
        assert lookup_test_price_or_zero(empty, "X") == 0
        assert lookup_test_fallback(zero, "X") == 0
        assert lookup_test_fallback(empty, "X") == 5
        assert raises("value.missing_key") { lookup_test_eager_default(zero, "X") }
        assert eval(lookup_test_atomic_price, book: [zero, empty, zero], key: ["X"]) == [0, _, 0]
        assert raises("value.missing_key") { lookup_test_strict(empty, "X") }
        assert raises("value.missing_key") { lookup_test_strict_at(empty, "X") }
        assert raises("value.missing_key") {
            eval(lookup_test_atomic_strict, book: [empty], key: ["X"])
        }
    }
}
