module hgraph.std part error_capture_tests

test {

    const fn capture_test_checked(value: i64) -> result<i64, error> {
        if value < 0 { return err(error(capture_test_message: "negative price")) }
        return ok(value)
    }
    fn capture_test_required(value: i64) -> i64 {
        when { return capture_test_checked(value)? }
    }
    fn capture_test_forward(value: i64) -> i64 { when { return value } }
    fn capture_test_pipeline(value: i64) -> i64 => capture_test_forward(capture_test_required(value))
    fn capture_test_tagged(value: i64) -> result<i64, error> { when { return capture_test_checked(value) } }
    fn capture_test_is_failure(value: result<i64, error>) -> bool {
        when { return is_err(value) }
    }
    fn capture_test_error_event(failure: error, step: i64) -> bool {
        when modified(step) && valid(step) { return modified(failure) }
    }
    fn capture_test_error_present(failure: error, step: i64) -> bool {
        when modified(step) && valid(step) { return valid(failure) }
    }
    fn capture_test_message(failure: error, step: i64) -> str {
        when modified(step) && valid(failure) { return failure.capture_test_message }
    }
    fn capture_test_origin_is_current(failure: error, step: i64) -> bool {
        inject clock
        when modified(step) && valid(failure) {
            let origin = failure.context
            if origin != null {
                return origin.phase == "evaluate" && origin.evaluation_time == clock.evaluation_time
            }
        }
    }
    fn capture_test_captured_value(value: i64) -> i64 {
        let seen = capture(capture_test_required, value)
        capture_test_forward(seen.value)
    }
    fn capture_test_captured_graph_value(value: i64) -> i64 {
        let seen = capture(capture_test_pipeline, value)
        capture_test_forward(seen.value)
    }
    fn capture_test_captured_events(value: i64, step: i64) -> bool {
        let seen = capture(capture_test_required, value)
        capture_test_error_event(seen.error, step)
    }
    fn capture_test_captured_presence(value: i64, step: i64) -> bool {
        let seen = capture(capture_test_required, value)
        capture_test_error_present(seen.error, step)
    }
    fn capture_test_captured_messages(value: i64, step: i64) -> str {
        let seen = capture(capture_test_required, value)
        capture_test_message(seen.error, step)
    }
    fn capture_test_captured_origin(value: i64, step: i64) -> bool {
        let seen = capture(capture_test_required, value)
        capture_test_origin_is_current(seen.error, step)
    }
    fn capture_test_tagged_value(value: i64) -> bool {
        let seen = capture(capture_test_tagged, value)
        capture_test_is_failure(seen.value)
    }
    fn capture_test_tagged_events(value: i64, step: i64) -> bool {
        let seen = capture(capture_test_tagged, value)
        capture_test_error_event(seen.error, step)
    }
    fn capture_test_inner_error(value: i64) -> error {
        let inner = capture(capture_test_required, value)
        inner.error
    }
    fn capture_test_outer_events(value: i64, step: i64) -> bool {
        let outer = capture(capture_test_inner_error, value)
        capture_test_error_event(outer.error, step)
    }
    fn capture_test_forwarded_origin(value: i64, step: i64) -> bool {
        let outer = capture(capture_test_inner_error, value)
        capture_test_origin_is_current(outer.value, step)
    }
    fn capture_test_writes_first(value: i64) -> i64 {
        inject out
        when {
            out = value
            let accepted = capture_test_checked(value)?
            return accepted + 100
        }
    }
    fn capture_test_preserved_writes(value: i64) -> i64 {
        let seen = capture(capture_test_writes_first, value)
        capture_test_forward(seen.value)
    }
    fn capture_test_consume_value(value: i64) { when { } }
    fn capture_test_consume_error(failure: error) { when { } }
    fn capture_test_unrelated(value: i64) -> i64 { when { return value + 100 } }
    fn capture_test_sibling_continues(value: i64) -> i64 {
        let seen = capture(capture_test_required, value)
        capture_test_consume_error(seen.error)
        capture_test_unrelated(value)
    }
    fn capture_test_per_key(book: map<str, i64>) {
        for key, value in items(book) {
            let seen = capture(capture_test_required, value)
            capture_test_consume_value(seen.value)
            capture_test_consume_error(seen.error)
        }
    }
    fn capture_test_fails_start(value: i64) -> i64 {
        start { at(map<str, i64>(items: []), "X") }
        when { return value }
    }
    fn capture_test_captured_start(value: i64) -> i64 {
        let seen = capture(capture_test_fails_start, value)
        seen.value
    }

    test capture_retains_events_and_continues {
        assert eval(capture_test_tagged_value, value: [-1, -1, 7]) == [true, true, false]
        assert eval(capture_test_tagged_events, value: [-1, -1, 7], step: [0, 1, 2]) == [false, false, false]
        assert eval(capture_test_captured_value, value: [7, -1, _, 8, -1, -1, _]) == [7, _, _, 8, _, _, _]
        assert eval(capture_test_captured_graph_value, value: [7, -1, _, 8]) == [7, _, _, 8]
        assert eval(capture_test_captured_events, value: [7, -1, _, 8, -1, -1, _], step: [0, 1, 2, 3, 4, 5, 6]) == [
            false, true, false, false, true, true, false
        ]
        assert eval(capture_test_captured_presence, value: [7, -1, _, 8], step: [0, 1, 2, 3]) == [false, true, true, true]
        assert eval(capture_test_captured_messages, value: [7, -1, _, 8], step: [0, 1, 2, 3]) == [
            _, "negative price", "negative price", "negative price"
        ]
        assert eval(capture_test_captured_origin, value: [7, -1, _, 8, -1], step: [0, 1, 2, 3, 4]) == [_, true, false, false, true]
        assert eval(capture_test_outer_events, value: [7, -1, _, 8, -1], step: [0, 1, 2, 3, 4]) == [false, false, false, false, false]
        assert eval(capture_test_forwarded_origin, value: [7, -1, _, 8, -1], step: [0, 1, 2, 3, 4]) == [_, true, false, false, true]
        assert eval(capture_test_preserved_writes, value: [7, -1, 8, -1]) == [107, -1, 108, -1]
        assert eval(capture_test_sibling_continues, value: [7, -1, 8, -1]) == [107, 99, 108, 99]
        eval(capture_test_per_key, book: [
            delta<map<str, i64>>(upsert: ["A": -1, "B": 7]),
            delta<map<str, i64>>(upsert: ["A": 8, "B": 9]),
            delta<map<str, i64>>(remove: ["A"]),
            delta<map<str, i64>>(upsert: ["A": -1])
        ])
        assert raises("value.missing_key") { eval(capture_test_captured_start, value: [1]) }
    }
}
