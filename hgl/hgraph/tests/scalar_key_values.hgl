            delta<set<civil_datetime>>(added: [@1970-01-01T00:00]),
            _,
            delta<set<civil_datetime>>(added: [@2024-02-29T00:00], removed: [@1970-01-01T00:00]),
            delta<set<civil_datetime>>(removed: [@2024-02-29T00:00]),
            delta<set<civil_datetime>>(added: [@1970-01-01T00:00]),
            _
        ]) == [
