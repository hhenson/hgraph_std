    test timezone_members_and_keys_preserve_exact_identity {
        assert eval(key_set_timezone, [
            delta<set<timezone>>(added: [@[US/Eastern]]),
            _,
            delta<set<timezone>>(added: [@[America/New_York]], removed: [@[US/Eastern]]),
            delta<set<timezone>>(removed: [@[America/New_York]]),
            delta<set<timezone>>(added: [@[US/Eastern]]),
            _
        ]) == [
            delta<set<timezone>>(added: [@[US/Eastern]]),
            _,
            delta<set<timezone>>(added: [@[America/New_York]], removed: [@[US/Eastern]]),
            delta<set<timezone>>(removed: [@[America/New_York]]),
            delta<set<timezone>>(added: [@[US/Eastern]]),
            _
        ]
        assert eval(key_map_timezone, [
            delta<map<timezone, i64>>(upsert: [@[US/Eastern]: 0]),
            delta<map<timezone, i64>>(upsert: [@[US/Eastern]: 0]),
            _,
            delta<map<timezone, i64>>(upsert: [@[America/New_York]: 2]),
            delta<map<timezone, i64>>(remove: [@[US/Eastern]]),
            delta<map<timezone, i64>>(upsert: [@[US/Eastern]: 3]),
            _
        ]) == [
            delta<map<timezone, i64>>(upsert: [@[US/Eastern]: 0]),
            delta<map<timezone, i64>>(upsert: [@[US/Eastern]: 0]),
            _,
            delta<map<timezone, i64>>(upsert: [@[America/New_York]: 2]),
            delta<map<timezone, i64>>(remove: [@[US/Eastern]]),
            delta<map<timezone, i64>>(upsert: [@[US/Eastern]: 3]),
            _
        ]
        assert eval(key_set_timezone, []) == []
        assert eval(key_map_timezone, [_, _, _]) == [_, _, _]
    }

    test zoned_datetime_members_and_keys_preserve_exact_identity {
        assert eval(key_set_zoned_datetime, [
            delta<set<zoned_datetime>>(added: [@2026-01-15T12:30+00:00[Etc/UTC]]),
            _,
            delta<set<zoned_datetime>>(added: [@2026-01-15T13:30+01:00[Europe/Paris]], removed: [@2026-01-15T12:30+00:00[Etc/UTC]]),
            delta<set<zoned_datetime>>(removed: [@2026-01-15T13:30+01:00[Europe/Paris]]),
            delta<set<zoned_datetime>>(added: [@2026-01-15T12:30+00:00[Etc/UTC]]),
            _
        ]) == [
            delta<set<zoned_datetime>>(added: [@2026-01-15T12:30+00:00[Etc/UTC]]),
            _,
            delta<set<zoned_datetime>>(added: [@2026-01-15T13:30+01:00[Europe/Paris]], removed: [@2026-01-15T12:30+00:00[Etc/UTC]]),
            delta<set<zoned_datetime>>(removed: [@2026-01-15T13:30+01:00[Europe/Paris]]),
            delta<set<zoned_datetime>>(added: [@2026-01-15T12:30+00:00[Etc/UTC]]),
            _
        ]
        assert eval(key_map_zoned_datetime, [
            delta<map<zoned_datetime, i64>>(upsert: [@2026-01-15T12:30+00:00[Etc/UTC]: 0]),
            delta<map<zoned_datetime, i64>>(upsert: [@2026-01-15T12:30+00:00[Etc/UTC]: 0]),
            _,
            delta<map<zoned_datetime, i64>>(upsert: [@2026-01-15T13:30+01:00[Europe/Paris]: 2]),
            delta<map<zoned_datetime, i64>>(remove: [@2026-01-15T12:30+00:00[Etc/UTC]]),
            delta<map<zoned_datetime, i64>>(upsert: [@2026-01-15T12:30+00:00[Etc/UTC]: 3]),
            _
        ]) == [
            delta<map<zoned_datetime, i64>>(upsert: [@2026-01-15T12:30+00:00[Etc/UTC]: 0]),
            delta<map<zoned_datetime, i64>>(upsert: [@2026-01-15T12:30+00:00[Etc/UTC]: 0]),
            _,
            delta<map<zoned_datetime, i64>>(upsert: [@2026-01-15T13:30+01:00[Europe/Paris]: 2]),
            delta<map<zoned_datetime, i64>>(remove: [@2026-01-15T12:30+00:00[Etc/UTC]]),
            delta<map<zoned_datetime, i64>>(upsert: [@2026-01-15T12:30+00:00[Etc/UTC]: 3]),
            _
        ]
        assert eval(key_set_zoned_datetime, []) == []
        assert eval(key_map_zoned_datetime, [_, _, _]) == [_, _, _]
    }

    test zoned_time_members_and_keys_preserve_exact_identity {
        assert eval(key_set_zoned_time, [
            delta<set<zoned_time>>(added: [@09:30[US/Eastern]]),
            _,
            delta<set<zoned_time>>(added: [@09:30[America/New_York]], removed: [@09:30[US/Eastern]]),
            delta<set<zoned_time>>(removed: [@09:30[America/New_York]]),
            delta<set<zoned_time>>(added: [@09:30[US/Eastern]]),
            _
        ]) == [
            delta<set<zoned_time>>(added: [@09:30[US/Eastern]]),
            _,
            delta<set<zoned_time>>(added: [@09:30[America/New_York]], removed: [@09:30[US/Eastern]]),
            delta<set<zoned_time>>(removed: [@09:30[America/New_York]]),
            delta<set<zoned_time>>(added: [@09:30[US/Eastern]]),
            _
