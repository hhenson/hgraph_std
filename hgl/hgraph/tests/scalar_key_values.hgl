module hgraph.std part scalar_key_values_tests

enum CollectionKeyMode { first = -7, second = 11 }

test {
    fn key_set_bool(value: set<bool>) -> set<bool> => pass_through(value)
    fn key_map_bool(value: map<bool, i64>) -> map<bool, i64> => pass_through(value)
    fn key_set_i64(value: set<i64>) -> set<i64> => pass_through(value)
    fn key_map_i64(value: map<i64, i64>) -> map<i64, i64> => pass_through(value)
    fn key_set_f64(value: set<f64>) -> set<f64> => pass_through(value)
    fn key_map_f64(value: map<f64, i64>) -> map<f64, i64> => pass_through(value)
    fn key_set_str(value: set<str>) -> set<str> => pass_through(value)
    fn key_map_str(value: map<str, i64>) -> map<str, i64> => pass_through(value)
    fn key_set_date(value: set<date>) -> set<date> => pass_through(value)
    fn key_map_date(value: map<date, i64>) -> map<date, i64> => pass_through(value)
    fn key_set_time(value: set<time>) -> set<time> => pass_through(value)
    fn key_map_time(value: map<time, i64>) -> map<time, i64> => pass_through(value)
    fn key_set_datetime(value: set<datetime>) -> set<datetime> => pass_through(value)
    fn key_map_datetime(value: map<datetime, i64>) -> map<datetime, i64> => pass_through(value)
    fn key_set_duration(value: set<duration>) -> set<duration> => pass_through(value)
    fn key_map_duration(value: map<duration, i64>) -> map<duration, i64> => pass_through(value)
    fn key_set_civil(value: set<civil_datetime>) -> set<civil_datetime> => pass_through(value)
    fn key_map_civil(value: map<civil_datetime, i64>) -> map<civil_datetime, i64> => pass_through(value)
    fn key_set_timezone(value: set<timezone>) -> set<timezone> => pass_through(value)
    fn key_map_timezone(value: map<timezone, i64>) -> map<timezone, i64> => pass_through(value)
    fn key_set_zoned_datetime(value: set<zoned_datetime>) -> set<zoned_datetime> => pass_through(value)
    fn key_map_zoned_datetime(value: map<zoned_datetime, i64>) -> map<zoned_datetime, i64> => pass_through(value)
    fn key_set_zoned_time(value: set<zoned_time>) -> set<zoned_time> => pass_through(value)
    fn key_map_zoned_time(value: map<zoned_time, i64>) -> map<zoned_time, i64> => pass_through(value)
    fn key_set_enum(value: set<CollectionKeyMode>) -> set<CollectionKeyMode> => pass_through(value)
    fn key_map_enum(value: map<CollectionKeyMode, i64>) -> map<CollectionKeyMode, i64> => pass_through(value)

    # Key equality controls membership; recording retains each sparse publication.
    test bool_members_and_keys_preserve_exact_identity {
        assert eval(key_set_bool, [
            delta<set<bool>>(added: [false]),
            _,
            delta<set<bool>>(added: [true], removed: [false]),
            delta<set<bool>>(removed: [true]),
            delta<set<bool>>(added: [false]),
            _
        ]) == [
            delta<set<bool>>(added: [false]),
            _,
            delta<set<bool>>(added: [true], removed: [false]),
            delta<set<bool>>(removed: [true]),
            delta<set<bool>>(added: [false]),
            _
        ]
        assert eval(key_map_bool, [
            delta<map<bool, i64>>(upsert: [false: 0]),
            delta<map<bool, i64>>(upsert: [false: 0]),
            _,
            delta<map<bool, i64>>(upsert: [true: 2]),
            delta<map<bool, i64>>(remove: [false]),
            delta<map<bool, i64>>(upsert: [false: 3]),
            _
        ]) == [
            delta<map<bool, i64>>(upsert: [false: 0]),
            delta<map<bool, i64>>(upsert: [false: 0]),
            _,
            delta<map<bool, i64>>(upsert: [true: 2]),
            delta<map<bool, i64>>(remove: [false]),
            delta<map<bool, i64>>(upsert: [false: 3]),
            _
        ]
        assert eval(key_set_bool, []) == []
        assert eval(key_map_bool, [_, _, _]) == [_, _, _]
    }

    test i64_members_and_keys_preserve_exact_identity {
        assert eval(key_set_i64, [
            delta<set<i64>>(added: [-7]),
            _,
            delta<set<i64>>(added: [11], removed: [-7]),
            delta<set<i64>>(removed: [11]),
            delta<set<i64>>(added: [-7]),
            _
        ]) == [
            delta<set<i64>>(added: [-7]),
            _,
            delta<set<i64>>(added: [11], removed: [-7]),
            delta<set<i64>>(removed: [11]),
            delta<set<i64>>(added: [-7]),
            _
        ]
        assert eval(key_map_i64, [
            delta<map<i64, i64>>(upsert: [-7: 0]),
            delta<map<i64, i64>>(upsert: [-7: 0]),
            _,
            delta<map<i64, i64>>(upsert: [11: 2]),
            delta<map<i64, i64>>(remove: [-7]),
            delta<map<i64, i64>>(upsert: [-7: 3]),
            _
        ]) == [
            delta<map<i64, i64>>(upsert: [-7: 0]),
            delta<map<i64, i64>>(upsert: [-7: 0]),
            _,
            delta<map<i64, i64>>(upsert: [11: 2]),
            delta<map<i64, i64>>(remove: [-7]),
            delta<map<i64, i64>>(upsert: [-7: 3]),
            _
        ]
        assert eval(key_set_i64, []) == []
        assert eval(key_map_i64, [_, _, _]) == [_, _, _]
    }

    test f64_members_and_keys_preserve_exact_identity {
        assert eval(key_set_f64, [
            delta<set<f64>>(added: [-1.5]),
            _,
            delta<set<f64>>(added: [2.5], removed: [-1.5]),
            delta<set<f64>>(removed: [2.5]),
            delta<set<f64>>(added: [-1.5]),
            _
        ]) == [
            delta<set<f64>>(added: [-1.5]),
            _,
            delta<set<f64>>(added: [2.5], removed: [-1.5]),
            delta<set<f64>>(removed: [2.5]),
            delta<set<f64>>(added: [-1.5]),
            _
        ]
        assert eval(key_map_f64, [
            delta<map<f64, i64>>(upsert: [-1.5: 0]),
            delta<map<f64, i64>>(upsert: [-1.5: 0]),
            _,
            delta<map<f64, i64>>(upsert: [2.5: 2]),
            delta<map<f64, i64>>(remove: [-1.5]),
            delta<map<f64, i64>>(upsert: [-1.5: 3]),
            _
        ]) == [
            delta<map<f64, i64>>(upsert: [-1.5: 0]),
            delta<map<f64, i64>>(upsert: [-1.5: 0]),
            _,
            delta<map<f64, i64>>(upsert: [2.5: 2]),
            delta<map<f64, i64>>(remove: [-1.5]),
            delta<map<f64, i64>>(upsert: [-1.5: 3]),
            _
        ]
        assert eval(key_set_f64, []) == []
        assert eval(key_map_f64, [_, _, _]) == [_, _, _]
    }

    test str_members_and_keys_preserve_exact_identity {
        assert eval(key_set_str, [
            delta<set<str>>(added: [""]),
            _,
            delta<set<str>>(added: ["next"], removed: [""]),
            delta<set<str>>(removed: ["next"]),
            delta<set<str>>(added: [""]),
            _
        ]) == [
            delta<set<str>>(added: [""]),
            _,
            delta<set<str>>(added: ["next"], removed: [""]),
            delta<set<str>>(removed: ["next"]),
            delta<set<str>>(added: [""]),
            _
        ]
        assert eval(key_map_str, [
            delta<map<str, i64>>(upsert: ["": 0]),
            delta<map<str, i64>>(upsert: ["": 0]),
            _,
            delta<map<str, i64>>(upsert: ["next": 2]),
            delta<map<str, i64>>(remove: [""]),
            delta<map<str, i64>>(upsert: ["": 3]),
            _
        ]) == [
            delta<map<str, i64>>(upsert: ["": 0]),
            delta<map<str, i64>>(upsert: ["": 0]),
            _,
            delta<map<str, i64>>(upsert: ["next": 2]),
            delta<map<str, i64>>(remove: [""]),
            delta<map<str, i64>>(upsert: ["": 3]),
            _
        ]
        assert eval(key_set_str, []) == []
        assert eval(key_map_str, [_, _, _]) == [_, _, _]
    }

    test date_members_and_keys_preserve_exact_identity {
        assert eval(key_set_date, [
            delta<set<date>>(added: [@1970-01-01]),
            _,
            delta<set<date>>(added: [@2024-02-29], removed: [@1970-01-01]),
            delta<set<date>>(removed: [@2024-02-29]),
            delta<set<date>>(added: [@1970-01-01]),
            _
        ]) == [
            delta<set<date>>(added: [@1970-01-01]),
            _,
            delta<set<date>>(added: [@2024-02-29], removed: [@1970-01-01]),
            delta<set<date>>(removed: [@2024-02-29]),
            delta<set<date>>(added: [@1970-01-01]),
            _
        ]
        assert eval(key_map_date, [
            delta<map<date, i64>>(upsert: [@1970-01-01: 0]),
            delta<map<date, i64>>(upsert: [@1970-01-01: 0]),
            _,
            delta<map<date, i64>>(upsert: [@2024-02-29: 2]),
            delta<map<date, i64>>(remove: [@1970-01-01]),
            delta<map<date, i64>>(upsert: [@1970-01-01: 3]),
            _
        ]) == [
            delta<map<date, i64>>(upsert: [@1970-01-01: 0]),
            delta<map<date, i64>>(upsert: [@1970-01-01: 0]),
            _,
            delta<map<date, i64>>(upsert: [@2024-02-29: 2]),
            delta<map<date, i64>>(remove: [@1970-01-01]),
            delta<map<date, i64>>(upsert: [@1970-01-01: 3]),
            _
        ]
        assert eval(key_set_date, []) == []
        assert eval(key_map_date, [_, _, _]) == [_, _, _]
    }

    test time_members_and_keys_preserve_exact_identity {
        assert eval(key_set_time, [
            delta<set<time>>(added: [@00:00]),
            _,
            delta<set<time>>(added: [@23:59:59.999999], removed: [@00:00]),
            delta<set<time>>(removed: [@23:59:59.999999]),
            delta<set<time>>(added: [@00:00]),
            _
        ]) == [
            delta<set<time>>(added: [@00:00]),
            _,
            delta<set<time>>(added: [@23:59:59.999999], removed: [@00:00]),
            delta<set<time>>(removed: [@23:59:59.999999]),
            delta<set<time>>(added: [@00:00]),
            _
        ]
        assert eval(key_map_time, [
            delta<map<time, i64>>(upsert: [@00:00: 0]),
            delta<map<time, i64>>(upsert: [@00:00: 0]),
            _,
            delta<map<time, i64>>(upsert: [@23:59:59.999999: 2]),
            delta<map<time, i64>>(remove: [@00:00]),
            delta<map<time, i64>>(upsert: [@00:00: 3]),
            _
        ]) == [
            delta<map<time, i64>>(upsert: [@00:00: 0]),
            delta<map<time, i64>>(upsert: [@00:00: 0]),
            _,
            delta<map<time, i64>>(upsert: [@23:59:59.999999: 2]),
            delta<map<time, i64>>(remove: [@00:00]),
            delta<map<time, i64>>(upsert: [@00:00: 3]),
            _
        ]
        assert eval(key_set_time, []) == []
        assert eval(key_map_time, [_, _, _]) == [_, _, _]
    }

    test datetime_members_and_keys_preserve_exact_identity {
        assert eval(key_set_datetime, [
            delta<set<datetime>>(added: [@1970-01-01T00:00Z]),
            _,
            delta<set<datetime>>(added: [@2024-02-29T00:00Z], removed: [@1970-01-01T00:00Z]),
            delta<set<datetime>>(removed: [@2024-02-29T00:00Z]),
            delta<set<datetime>>(added: [@1970-01-01T00:00Z]),
            _
        ]) == [
            delta<set<datetime>>(added: [@1970-01-01T00:00Z]),
            _,
            delta<set<datetime>>(added: [@2024-02-29T00:00Z], removed: [@1970-01-01T00:00Z]),
            delta<set<datetime>>(removed: [@2024-02-29T00:00Z]),
            delta<set<datetime>>(added: [@1970-01-01T00:00Z]),
            _
        ]
        assert eval(key_map_datetime, [
            delta<map<datetime, i64>>(upsert: [@1970-01-01T00:00Z: 0]),
            delta<map<datetime, i64>>(upsert: [@1970-01-01T00:00Z: 0]),
            _,
            delta<map<datetime, i64>>(upsert: [@2024-02-29T00:00Z: 2]),
            delta<map<datetime, i64>>(remove: [@1970-01-01T00:00Z]),
            delta<map<datetime, i64>>(upsert: [@1970-01-01T00:00Z: 3]),
            _
        ]) == [
            delta<map<datetime, i64>>(upsert: [@1970-01-01T00:00Z: 0]),
            delta<map<datetime, i64>>(upsert: [@1970-01-01T00:00Z: 0]),
            _,
            delta<map<datetime, i64>>(upsert: [@2024-02-29T00:00Z: 2]),
            delta<map<datetime, i64>>(remove: [@1970-01-01T00:00Z]),
            delta<map<datetime, i64>>(upsert: [@1970-01-01T00:00Z: 3]),
            _
        ]
        assert eval(key_set_datetime, []) == []
        assert eval(key_map_datetime, [_, _, _]) == [_, _, _]
    }

    test duration_members_and_keys_preserve_exact_identity {
        assert eval(key_set_duration, [
            delta<set<duration>>(added: [0us]),
            _,
            delta<set<duration>>(added: [1s], removed: [0us]),
