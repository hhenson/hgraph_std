    test enum_members_and_keys_preserve_exact_identity {
        assert eval(key_set_enum, [
            delta<set<CollectionKeyMode>>(added: [CollectionKeyMode::first]),
            _,
            delta<set<CollectionKeyMode>>(added: [CollectionKeyMode::second], removed: [CollectionKeyMode::first]),
            delta<set<CollectionKeyMode>>(removed: [CollectionKeyMode::second]),
            delta<set<CollectionKeyMode>>(added: [CollectionKeyMode::first]),
            _
        ]) == [
            delta<set<CollectionKeyMode>>(added: [CollectionKeyMode::first]),
            _,
            delta<set<CollectionKeyMode>>(added: [CollectionKeyMode::second], removed: [CollectionKeyMode::first]),
            delta<set<CollectionKeyMode>>(removed: [CollectionKeyMode::second]),
            delta<set<CollectionKeyMode>>(added: [CollectionKeyMode::first]),
            _
        ]
        assert eval(key_map_enum, [
            delta<map<CollectionKeyMode, i64>>(upsert: [CollectionKeyMode::first: 0]),
            delta<map<CollectionKeyMode, i64>>(upsert: [CollectionKeyMode::first: 0]),
            _,
            delta<map<CollectionKeyMode, i64>>(upsert: [CollectionKeyMode::second: 2]),
            delta<map<CollectionKeyMode, i64>>(remove: [CollectionKeyMode::first]),
            delta<map<CollectionKeyMode, i64>>(upsert: [CollectionKeyMode::first: 3]),
            _
        ]) == [
            delta<map<CollectionKeyMode, i64>>(upsert: [CollectionKeyMode::first: 0]),
            delta<map<CollectionKeyMode, i64>>(upsert: [CollectionKeyMode::first: 0]),
            _,
            delta<map<CollectionKeyMode, i64>>(upsert: [CollectionKeyMode::second: 2]),
            delta<map<CollectionKeyMode, i64>>(remove: [CollectionKeyMode::first]),
            delta<map<CollectionKeyMode, i64>>(upsert: [CollectionKeyMode::first: 3]),
            _
        ]
        assert eval(key_set_enum, []) == []
        assert eval(key_map_enum, [_, _, _]) == [_, _, _]
    }

    # Signed zeros name one member/key; removal may use either spelling.
    test float_keys_use_ordinary_signed_zero_equality {
        assert eval(key_set_f64, [delta<set<f64>>(added: [-0.0]), delta<set<f64>>(removed: [0.0])]) == [delta<set<f64>>(added: [0.0]), delta<set<f64>>(removed: [-0.0])]
        assert eval(key_map_f64, [delta<map<f64, i64>>(upsert: [-0.0: 1]), delta<map<f64, i64>>(upsert: [0.0: 2]), delta<map<f64, i64>>(remove: [-0.0])]) == [delta<map<f64, i64>>(upsert: [0.0: 1]), delta<map<f64, i64>>(upsert: [-0.0: 2]), delta<map<f64, i64>>(remove: [0.0])]
    }
}
