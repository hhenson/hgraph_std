            delta<map<civil_datetime, i64>>(upsert: [@1970-01-01T00:00: 0]),
            delta<map<civil_datetime, i64>>(upsert: [@1970-01-01T00:00: 0]),
            _,
            delta<map<civil_datetime, i64>>(upsert: [@2024-02-29T00:00: 2]),
            delta<map<civil_datetime, i64>>(remove: [@1970-01-01T00:00]),
