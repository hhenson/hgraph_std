        ]) == [
            delta<map<duration, i64>>(upsert: [0us: 0]),
            delta<map<duration, i64>>(upsert: [0us: 0]),
            _,
            delta<map<duration, i64>>(upsert: [1s: 2]),
            delta<map<duration, i64>>(remove: [0us]),
